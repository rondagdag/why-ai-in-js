  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "RAG",
    "LlamaIndex",
    "Ollama",
    "AI",
    "TypeScript"
  ],
  "author": "Ron Dagdag",
  "license": "MIT",
  "dependencies": {
    "@llamaindex/ollama": "^0.1.23",
    "@llamaindex/openai": "^0.4.22",
    "@llamaindex/readers": "^3.1.21",
    "@llamaindex/workflow": "^1.1.24",
    "dotenv": "^16.4.0",
    "llamaindex": "^0.12.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
